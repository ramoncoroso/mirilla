{
  "name": "mirilla",
  "description": "Lector de códigos QR y de barras privado y anti-quishing para Chrome y Firefox",
  "license": "MIT",
  "author": "Ramón Coroso",
  "repository": "github:ramoncoroso/mirilla",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "E2E=1 wxt build && playwright test",
    "postinstall": "wxt prepare",
    "test:firefox": "E2E=1 wxt zip -b firefox && MIRILLA_XPI=.output-e2e/mirilla-$npm_package_version-firefox.zip node --test --test-concurrency=1 tests/firefox/smoke.test.ts",
    "store:assets": "E2E=1 wxt build && playwright test -c store/playwright.config.ts",
    "store:notes": "wxt build -b firefox && node store/reviewer-notes.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/selenium-webdriver": "^4.35.7",
    "geckodriver": "^7.0.0",
    "selenium-webdriver": "^4.49.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "tldts": "^7.4.16",
    "zxing-wasm": "^3.1.4"
  },
  "engines": {
    "node": ">=22.18"
  }
}
